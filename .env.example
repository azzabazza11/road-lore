# Copy this file to `.env` and paste your key. NEVER commit `.env` (it is gitignored).
# The backend proxy (server.js) reads this and calls Gemini server-side, so the
# key is never exposed to the browser.
#
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: sign trial tokens with a dedicated secret (defaults to GEMINI_API_KEY).
# TRIAL_SECRET=
# TRIAL_MS=604800000
