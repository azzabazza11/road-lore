{
  "id": "https://azzabazza11.github.io/road-lore/",
  "name": "Passenger Tales",
  "short_name": "Passenger Tales",
  "lang": "en",
  "dir": "ltr",
  "description": "Passenger companion that narrates local history, geology, and interesting places as you drive. v1.9.2",
  "start_url": "./index.html?homescreen=1",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0e141b",
  "theme_color": "#10161c",
  "categories": ["travel", "lifestyle", "navigation"],
  "prefer_related_applications": false,
  "handle_links": "preferred",
  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  },
  "icons": [
    {
      "src": "./icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "./icon-180.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "screenshots": [
    {
      "src": "./screenshot-narrow.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Nearby lore on a phone"
    },
    {
      "src": "./screenshot-wide.png",
      "sizes": "1920x1080",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Passenger Tales on a wide screen"
    }
  ]
}
